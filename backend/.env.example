# ==========================================
# KelsGaming RO - Backend Configuration
# ==========================================

# Application Port & Host
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# CORS Allowed Origins (Comma separated or * for dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://32.236.113.36

# JWT Authentication Secret & Lifetimes
JWT_SECRET=your_super_secret_jwt_key_please_change_for_production_use_random_32_bytes
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d

# Password Storage Mode for rAthena: 'raw' (default, use_MD5_passwords: no) or 'md5'
PASSWORD_STORAGE_MODE=raw

# rAthena Game Server (AWS EC2)
RATHENA_HOST=32.236.113.36
RATHENA_LOGIN_PORT=6900
RATHENA_CHAR_PORT=6121
RATHENA_MAP_PORT=5121
RATHENA_PING_TIMEOUT=2000
STATUS_CACHE_TTL_MS=10000

# MariaDB / MySQL Connection to rAthena Database
DB_HOST=32.236.113.36
DB_PORT=3306
DB_USER=ragnarok
DB_PASSWORD=ragnarok_secure_password_here
DB_NAME=ragnarok
DB_CONNECTION_LIMIT=10

# Server Mechanics & Rates Display
SERVER_BASE_EXP=25x
SERVER_JOB_EXP=25x
SERVER_DROP_RATE=10x
SERVER_CARD_DROP=10x
SERVER_MVP_DROP=5x
SERVER_MAX_BASE_LEVEL=99
SERVER_MAX_JOB_LEVEL=70
SERVER_MAX_STATS=99
SERVER_MAX_ASPD=190
SERVER_EPISODE=Episode 13.2 - Encounter with the Unknown
SERVER_MECHANICS=Pre-Renewal Transcendent
